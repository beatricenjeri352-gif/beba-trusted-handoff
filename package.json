    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "supabase": "^3.2.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3"
  }
